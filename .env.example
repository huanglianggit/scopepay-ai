# Copy to .env. Keys stay on the server. Sandbox is the only payment environment.
PUBLIC_BASE_URL=http://127.0.0.1:8791
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# demo = explicit rule-based walkthrough. openai = OpenAI-compatible chat API.
# ollama = local Ollama through its OpenAI-compatible endpoint.
AI_PROVIDER=demo
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=
AI_API_KEY=
# Required for owner access from a non-loopback address. Set before hosting.
OWNER_ACCESS_CODE=
# Optional SQLite path (default data/scopepay.sqlite3)
SCOPEPAY_DB=
